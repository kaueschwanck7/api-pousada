meta {
  name: 02 - Criar Reserva
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nomeHospede": "Teste CRUD - Ana Silva",
    "dataCheckin": "2026-12-10",
    "dataCheckout": "2026-12-15",
    "numeroQuarto": 201,
    "quantidadeHospedes": 2,
    "status": "Confirmada"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Status deve ser 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Resposta deve conter id", function() {
    expect(res.getBody().id).to.be.a('number');
  });
  test("Nome do hóspede deve ser correto", function() {
    expect(res.getBody().nomeHospede).to.equal("Teste CRUD - Ana Silva");
  });
}

script:post-response {
  bru.setVar("idCriado", res.getBody().id);
}
