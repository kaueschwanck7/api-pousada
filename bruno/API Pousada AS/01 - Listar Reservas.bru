meta {
  name: 01 - Listar Reservas
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/reservas
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("Status deve ser 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resposta deve ser um array", function() {
    expect(res.getBody()).to.be.an('array');
  });
}
